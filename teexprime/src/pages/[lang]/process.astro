---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getDictionary, path, staticLocalePaths, type Locale } from '../../i18n/config';

export const getStaticPaths = staticLocalePaths;
const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
---
<Base lang={lang} title={t.process.title} description={t.process.lead}>
  <PageHeader eyebrow={t.process.title} title={t.home.solutionTitle} lead={t.process.lead} />
  <section class="container-x pb-20 sm:pb-28">
    <ol class="relative ms-4 border-s border-line sm:ms-6">
      {t.process.steps.map((s, i) => (
        <li class="relative pb-12 ps-10 last:pb-0 sm:ps-14" data-reveal style={`--reveal-delay:${i * 40}ms`}>
          <span class:list={['absolute -start-4 top-0 grid size-8 place-items-center rounded-full border text-sm font-semibold sm:-start-5 sm:size-10',
            i === 0 ? 'border-transparent bg-accent text-on-accent' : 'border-line bg-bg text-ink-2']}>{i + 1}</span>
          <h2 class="text-2xl font-semibold sm:text-3xl">{s.title}</h2>
          <p class="mt-2 max-w-xl text-lg text-ink-2">{s.text}</p>
        </li>
      ))}
    </ol>
    <div class="card mt-20 p-8 sm:p-10" data-reveal>
      <h2 class="text-2xl font-semibold">{t.process.needTitle}</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {t.process.needs.map((n) => (
          <li class="flex gap-3 text-ink-2">
            <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent-ink" aria-hidden="true"></span>{n}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand title={t.home.ctaTitle} lead={t.home.ctaLead} href={path(lang, 'start')} label={t.common.startProject} />
</Base>
