---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { getDictionary, path } from '../i18n/config';
const t = getDictionary('en');
---
<Base lang="en" title="404">
  <section class="container-x py-32">
    <p class="eyebrow">404</p>
    <h1 class="h-section mt-4">{t.notFound.title}</h1>
    <p class="lead mt-4">{t.notFound.text}</p>
    <Button href={path('en')} class="mt-8">{t.notFound.home}</Button>
  </section>
</Base>
