---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getDictionary, path, staticLocalePaths, type Locale } from '../../i18n/config';
import { site } from '../../lib/site';

export const getStaticPaths = staticLocalePaths;
const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
---
<Base lang={lang} title={t.services.title} description={t.services.lead}>
  <PageHeader eyebrow={t.services.title} title={t.home.servicesTitle} lead={t.services.lead}>
    <div class="mt-8 animate-in" style="--delay:200ms">
      <StatusBadge tone="accent">{t.common.priceFrom.replace('{price}', String(site.minPriceUsd))}</StatusBadge>
    </div>
  </PageHeader>
  <section class="container-x pb-20 sm:pb-28">
    <div class="divide-y divide-line border-y border-line">
      {t.services.items.map((s, i) => (
        <div id={s.id} class="grid scroll-mt-24 gap-6 py-10 sm:py-14 lg:grid-cols-[5rem_1fr_1fr] lg:gap-10" data-reveal>
          <span class="font-display text-sm font-semibold text-accent-ink">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2 class="text-3xl font-semibold sm:text-4xl">{s.title}</h2>
            <p class="mt-4 max-w-md text-lg leading-relaxed text-ink-2">{s.for}</p>
          </div>
          <div>
            <p class="text-sm font-medium text-muted">{t.services.includesLabel}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {s.items.map((item) => <li class="rounded-full border border-line px-3.5 py-1.5 text-sm">{item}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>
  <CtaBand title={t.home.ctaTitle} lead={t.home.ctaLead} href={path(lang, 'start')} label={t.common.startProject} />
</Base>
