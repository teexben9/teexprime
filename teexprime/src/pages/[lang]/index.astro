---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Arrow from '../../components/Arrow.astro';
import CaseCard from '../../components/CaseCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getDictionary, path, staticLocalePaths, type Locale } from '../../i18n/config';
import { getWork } from '../../lib/work';

export const getStaticPaths = staticLocalePaths;
const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const work = (await getWork()).slice(0, 3);
---
<Base lang={lang}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-40 end-[-10%] size-[36rem] rounded-full bg-accent opacity-20 blur-[120px] dark:opacity-15" aria-hidden="true"></div>
    <div class="container-x relative pb-20 pt-16 sm:pb-28 sm:pt-28">
      <p class="eyebrow animate-in">{t.home.eyebrow}</p>
      <h1 class="h-display mt-5 max-w-5xl animate-in" style="--delay:80ms">{t.home.heroTitle}</h1>
      <p class="lead mt-7 max-w-2xl animate-in" style="--delay:160ms">{t.home.heroLead}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row animate-in" style="--delay:240ms">
        <Button href={path(lang, 'start')} size="lg">{t.common.startProject} <Arrow /></Button>
        <Button href={path(lang, 'work')} size="lg" variant="secondary">{t.common.viewWork}</Button>
      </div>
      <p class="mt-10 max-w-xl text-sm text-muted animate-in" style="--delay:320ms">{t.home.audience}</p>
    </div>
  </section>

  <!-- Problems -->
  <section class="section border-t border-line bg-surface">
    <div class="container-x">
      <p class="eyebrow" data-reveal>{t.home.problemsEyebrow}</p>
      <h2 class="h-section mt-4 max-w-3xl" data-reveal>{t.home.problemsTitle}</h2>
      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {t.home.problems.map((p, i) => (
          <div class="bg-surface p-7 transition-colors hover:bg-bg sm:p-8" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <span class="font-display text-sm font-semibold text-accent-ink">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-xl font-semibold">{p.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-2">{p.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-10" data-reveal>
        <Button href={path(lang, 'start')} variant="accent" size="lg">{t.home.problemsCta} <Arrow /></Button>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="section">
    <div class="container-x grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow" data-reveal>{t.home.solutionEyebrow}</p>
        <h2 class="h-section mt-4" data-reveal>{t.home.solutionTitle}</h2>
        <p class="lead mt-6" data-reveal>{t.home.solutionLead}</p>
      </div>
      <ol class="relative space-y-3">
        {t.home.solutionSteps.map((s, i) => (
          <li class="card flex items-center gap-5 px-6 py-5" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class:list={['grid size-9 shrink-0 place-items-center rounded-full text-sm font-semibold',
              i === 1 ? 'bg-accent text-on-accent' : 'bg-surface-2 text-ink-2']}>{i + 1}</span>
            <span class="font-display text-xl font-semibold">{s}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Work -->
  {work.length > 0 && (
    <section class="section border-t border-line">
      <div class="container-x">
        <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow" data-reveal>{t.home.workEyebrow}</p>
            <h2 class="h-section mt-4 max-w-2xl" data-reveal>{t.home.workTitle}</h2>
            <p class="lead mt-4 max-w-xl" data-reveal>{t.home.workLead}</p>
          </div>
          <Button href={path(lang, 'work')} variant="secondary" data-reveal>{t.common.viewWork} <Arrow /></Button>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {work.map((w, i) => (
            <CaseCard href={path(lang, `work/${w.id}`)} client={w.data.client} industry={w.data.industry}
              summary={w.data.summary} cta={t.common.viewCase} image={w.data.images[0]}
              placeholderLabel={t.work.labels.screenshotsSoon} delay={i * 90} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Services overview -->
  <section class="section border-t border-line bg-surface">
    <div class="container-x">
      <p class="eyebrow" data-reveal>{t.home.servicesEyebrow}</p>
      <h2 class="h-section mt-4 max-w-3xl" data-reveal>{t.home.servicesTitle}</h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.services.items.slice(0, 4).map((s, i) => (
          <a href={`${path(lang, 'services')}#${s.id}`} class="group card flex flex-col bg-bg p-6 transition-all hover:-translate-y-1 hover:border-ink/30"
            data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <h3 class="text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-2">{s.for}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-accent-ink">{t.common.learnMore} <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="pt-20 sm:pt-28"></div>
  <CtaBand title={t.home.ctaTitle} lead={t.home.ctaLead} href={path(lang, 'start')} label={t.common.startProject} />
</Base>
