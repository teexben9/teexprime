---
// Placeholder logo. To use the real logo, put the file in /public and set `logo` in src/lib/site.ts.
import { site } from '../lib/site';
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
{site.logo ? (
  <img src={site.logo} alt={site.name} class:list={['h-8 w-auto', className]} />
) : (
  <span class:list={['inline-flex items-center gap-2.5', className]} aria-label={site.name}>
    <span class="grid size-8 place-items-center rounded-lg bg-btn text-btn-ink" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M5 6h14M12 6v13" />
        <circle cx="18.5" cy="18" r="1.6" fill="var(--accent)" stroke="none" />
      </svg>
    </span>
    <span class="font-display text-lg font-semibold tracking-tight">{site.name}</span>
  </span>
)}
