---
import Button from './Button.astro';
import Arrow from './Arrow.astro';
interface Props { title: string; lead?: string; href: string; label: string }
const { title, lead, href, label } = Astro.props;
---
<section class="container-x pb-20 sm:pb-28">
  <div class="relative overflow-hidden rounded-3xl bg-btn px-6 py-14 text-btn-ink sm:px-14 sm:py-20" data-reveal>
    <div class="pointer-events-none absolute -end-24 -top-24 size-72 rounded-full bg-accent opacity-25 blur-3xl" aria-hidden="true"></div>
    <h2 class="h-section relative max-w-3xl">{title}</h2>
    {lead && <p class="relative mt-5 max-w-xl text-lg opacity-75">{lead}</p>}
    <Button href={href} variant="accent" size="lg" class="relative mt-9">{label} <Arrow /></Button>
  </div>
</section>
