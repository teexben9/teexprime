---
import WorkVisual from './WorkVisual.astro';
import Arrow from './Arrow.astro';
interface Props {
  href: string; client: string; industry: string; summary: string; cta: string;
  image?: { src: string; alt: string }; placeholderLabel?: string; delay?: number;
}
const { href, client, industry, summary, cta, image, placeholderLabel, delay = 0 } = Astro.props;
---
<a href={href} class="group card flex flex-col p-3 transition-all duration-300 hover:-translate-y-1 hover:border-ink/30 hover:shadow-xl hover:shadow-black/5"
  data-reveal style={`--reveal-delay:${delay}ms`}>
  <WorkVisual client={client} image={image} label={placeholderLabel} class="aspect-[16/10]" />
  <div class="flex flex-1 flex-col p-4 pt-5">
    <p class="text-xs font-medium uppercase tracking-wider text-muted">{industry}</p>
    <h3 class="mt-2 text-2xl font-semibold">{client}</h3>
    <p class="mt-3 flex-1 text-ink-2">{summary}</p>
    <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-accent-ink">{cta} <Arrow /></span>
  </div>
</a>
