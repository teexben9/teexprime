---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="container-x pb-12 pt-16 sm:pb-16 sm:pt-24">
  {eyebrow && <p class="eyebrow animate-in">{eyebrow}</p>}
  <h1 class="h-display mt-4 max-w-4xl animate-in" style="--delay:60ms">{title}</h1>
  {lead && <p class="lead mt-6 max-w-2xl animate-in" style="--delay:120ms">{lead}</p>}
  <slot />
</section>
