---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CaseCard from '../../../components/CaseCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getDictionary, path, staticLocalePaths, type Locale } from '../../../i18n/config';
import { getWork } from '../../../lib/work';

export const getStaticPaths = staticLocalePaths;
const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const work = await getWork();
---
<Base lang={lang} title={t.work.title} description={t.work.lead}>
  <PageHeader eyebrow={t.nav.work} title={t.home.workTitle} lead={t.work.lead} />
  <section class="container-x pb-20 sm:pb-28">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {work.map((w, i) => (
        <CaseCard href={path(lang, `work/${w.id}`)} client={w.data.client} industry={w.data.industry}
          summary={w.data.summary} cta={t.common.viewCase} image={w.data.images[0]}
          placeholderLabel={t.work.labels.screenshotsSoon} delay={(i % 3) * 90} />
      ))}
    </div>
    {work.length < 3 && <p class="mt-10 text-muted">{t.work.empty}</p>}
  </section>
  <CtaBand title={t.work.nextTitle} lead={t.home.ctaLead} href={path(lang, 'start')} label={t.common.startProject} />
</Base>
